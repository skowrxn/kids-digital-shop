{# PORADNIK — dominująca proza, maks. 65 znaków w linii. #}
{% import '_cwiczenia.html.j2' as w %}
{% import '_wstep.html.j2' as ws %}
{% set ns = namespace(nr=0) %}

{% set ns.nr = ns.nr + 1 %}{{ ws.okladka(c, ns.nr) }}
{% set ns.nr = ns.nr + 1 %}{{ ws.jak_korzystac(c, ns.nr) }}

{% for r in c.rozdzialy %}
  {% for s in r.strony %}
    {% set ns.nr = ns.nr + 1 %}
    <div class="strona">
      {{ w.naglowek('Rozdział ' ~ loop.parent.loop.index, r.tytul) }}
      {% if loop.first %}<h2 class="sekcja">{{ r.tytul }}</h2>{% endif %}
      {{ w.cwiczenie(s) }}
      {{ w.stopka(c, ns.nr) }}
    </div>
  {% endfor %}
  {% if r.get('do_zrobienia_w_tym_tygodniu') %}
    {% set ns.nr = ns.nr + 1 %}
    <div class="strona">
      {{ w.naglowek('Rozdział ' ~ loop.index, r.tytul) }}
      <h2 class="sekcja">do zrobienia w tym tygodniu</h2>
      <ul class="checklista" style="flex:1">
        {% for x in r.do_zrobienia_w_tym_tygodniu %}
          <li><span class="checklista__box"></span>{{ x }}</li>
        {% endfor %}
      </ul>
      {{ w.stopka(c, ns.nr) }}
    </div>
  {% endif %}
{% endfor %}

{% for s in c.get('checklisty', []) %}
  {% set ns.nr = ns.nr + 1 %}
  {{ w.strona_cwiczenia(c, s, 'Checklista', '', ns.nr) }}
{% endfor %}

{% set ns.nr = ns.nr + 1 %}{{ ws.klucz(c, ns.nr) }}
