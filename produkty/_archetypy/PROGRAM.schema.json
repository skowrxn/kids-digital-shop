{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lupa.pl/schema/PROGRAM.schema.json",
  "title": "PROGRAM — sekwencyjny kurs na N tygodni",
  "description": "Trudność rośnie monotonicznie. Każdy tydzień powtarza materiał z poprzednich (interleaving), nie tylko wprowadza nowy. Reguły niewyrażalne w JSON Schema (monotoniczność, interleaving, plan powtórek, liczba stron) sprawdza renderer/validate.py.",
  "type": "object",
  "required": [
    "meta",
    "wstep",
    "tygodnie",
    "klucz_odpowiedzi",
    "fragment"
  ],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "slug",
        "tytul",
        "archetyp",
        "wersja",
        "wiek",
        "strony_deklarowane",
        "min_pt_dziecka"
      ],
      "additionalProperties": false,
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "tytul": {
          "type": "string"
        },
        "podtytul": {
          "type": "string"
        },
        "archetyp": {
          "const": "PROGRAM"
        },
        "wersja": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+$"
        },
        "wiek": {
          "type": "string"
        },
        "kategoria": {
          "type": "string"
        },
        "podkategoria": {
          "type": "string"
        },
        "strony_deklarowane": {
          "type": "integer",
          "minimum": 8
        },
        "min_pt_dziecka": {
          "type": "integer",
          "minimum": 11,
          "description": "Minimalny stopień pisma treści dziecka. 14 dla dzieci uczących się czytać."
        },
        "ilustracja": {
          "$ref": "#/$defs/ilustracja"
        }
      }
    },
    "wstep": {
      "type": "object",
      "required": [
        "warunek_wejscia",
        "obietnica",
        "jak_korzystac",
        "czego_nie_robi"
      ],
      "additionalProperties": false,
      "properties": {
        "warunek_wejscia": {
          "type": "string"
        },
        "obietnica": {
          "type": "string"
        },
        "ile_czasu_dziennie": {
          "type": "string"
        },
        "jak_korzystac": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string"
          }
        },
        "czego_nie_robi": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string"
          },
          "description": "Krytyczne dla logopedii i emocji. Wchodzi na stronę 3 PDF-a."
        },
        "kiedy_do_specjalisty": {
          "type": "string"
        }
      }
    },
    "tygodnie": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "nr",
          "cel",
          "poziom_trudnosci",
          "nowy_material",
          "powtorka",
          "material_dziecka",
          "gra",
          "czytanka",
          "karta_rodzica",
          "karta_postepu"
        ],
        "additionalProperties": false,
        "properties": {
          "nr": {
            "type": "integer",
            "minimum": 1
          },
          "cel": {
            "type": "string",
            "description": "Jedno zdanie, do rodzica, druga osoba."
          },
          "poziom_trudnosci": {
            "type": "integer",
            "minimum": 1,
            "description": "MUSI rosnąć monotonicznie między kolejnymi tygodniami."
          },
          "nowy_material": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "litery": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "sylaby": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "wyrazy": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "opis": {
                "type": "string"
              }
            }
          },
          "powtorka": {
            "type": "object",
            "required": [
              "z_tygodni"
            ],
            "additionalProperties": false,
            "description": "Interleaving. Pusta lista z_tygodni dozwolona tylko w tygodniu 1.",
            "properties": {
              "z_tygodni": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "sylaby": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "wyrazy": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "material_dziecka": {
            "type": "array",
            "minItems": 1,
            "description": "Jedna pozycja = jedna strona PDF-a.",
            "items": {
              "$ref": "#/$defs/strona"
            }
          },
          "gra": {
            "type": "object",
            "required": [
              "nazwa",
              "cel",
              "zasady"
            ],
            "additionalProperties": false,
            "properties": {
              "nazwa": {
                "type": "string"
              },
              "cel": {
                "type": "string"
              },
              "gracze": {
                "type": "string"
              },
              "czas_min": {
                "type": "integer",
                "minimum": 1
              },
              "przygotowanie": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "zasady": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "string"
                }
              },
              "elementy_do_wyciecia": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "czytanka": {
            "type": "object",
            "required": [
              "tytul",
              "linie"
            ],
            "additionalProperties": false,
            "properties": {
              "tytul": {
                "type": "string"
              },
              "czyta": {
                "enum": [
                  "dziecko",
                  "rodzic",
                  "na_zmiane"
                ]
              },
              "linie": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                },
                "description": "Jedna linia = jedna linia druku. Podział na sylaby robi renderer."
              },
              "pytania": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "karta_rodzica": {
            "type": "object",
            "required": [
              "co_powiedziec",
              "na_co_uwazac",
              "kiedy_dalej"
            ],
            "additionalProperties": false,
            "properties": {
              "co_powiedziec": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "na_co_uwazac": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "kiedy_dalej": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "jesli_nie_idzie": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "karta_postepu": {
            "type": "object",
            "required": [
              "wiersze"
            ],
            "additionalProperties": false,
            "description": "ZAWSZE pusta. Wypełnia ją rodzic u siebie — żadnych danych dziecka.",
            "properties": {
              "naglowek": {
                "type": "string"
              },
              "wiersze": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "kolumny": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "ilustracja": {
            "$ref": "#/$defs/ilustracja"
          }
        }
      }
    },
    "klucz_odpowiedzi": {
      "type": "array",
      "description": "Wymagany dla każdej strony, której typ ma odpowiedzi. Sprawdza validate.py.",
      "items": {
        "type": "object",
        "required": [
          "strona_id",
          "odpowiedzi"
        ],
        "additionalProperties": false,
        "properties": {
          "strona_id": {
            "type": "string"
          },
          "odpowiedzi": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "fragment": {
      "type": "object",
      "required": [
        "do_tygodnia",
        "obietnica_na_stronie"
      ],
      "additionalProperties": false,
      "description": "Darmowy fragment. Żelazna zasada 1: min. 10 stron albo 1 pełny tydzień.",
      "properties": {
        "do_tygodnia": {
          "type": "integer",
          "minimum": 1
        },
        "obietnica_na_stronie": {
          "type": "string",
          "description": "Musi zgadzać się z tekstem na p-<slug>.html. Sprawdza validate.py."
        }
      }
    }
  },
  "$defs": {
    "strona": {
      "type": "object",
      "required": [
        "id",
        "typ",
        "polecenie",
        "dane"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^t\\d+-[a-z0-9-]+$"
        },
        "typ": {
          "enum": [
            "sylaby_tabela",
            "sylaby_sciezka",
            "lacz_sylaby",
            "wyrazy_do_czytania",
            "uzupelnij_sylabe",
            "wybierz_wyraz",
            "pisanie_sylab",
            "czytanie_zdan",
            "dyktando_sylabowe",
            "ramka_rysunkowa",
            "formularz"
          ]
        },
        "polecenie": {
          "type": "string",
          "maxLength": 60,
          "description": "Do dziecka. Maks. 8 słów, tryb rozkazujący, jeden czasownik."
        },
        "dla_rodzica": {
          "type": "string",
          "description": "Jedna linia 11pt pod poleceniem."
        },
        "dane": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "typ": {
                "const": "sylaby_tabela"
              }
            }
          },
          "then": {
            "properties": {
              "dane": {
                "$ref": "#/$defs/d_tabela"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "typ": {
                "const": "sylaby_sciezka"
              }
            }
          },
          "then": {
            "properties": {
              "dane": {
                "$ref": "#/$defs/d_sciezka"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "typ": {
                "const": "lacz_sylaby"
              }
            }
          },
          "then": {
            "properties": {
              "dane": {
                "$ref": "#/$defs/d_lacz"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "typ": {
                "const": "wyrazy_do_czytania"
              }
            }
          },
          "then": {
            "properties": {
              "dane": {
                "$ref": "#/$defs/d_wyrazy"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "typ": {
                "const": "uzupelnij_sylabe"
              }
            }
          },
          "then": {
            "properties": {
              "dane": {
                "$ref": "#/$defs/d_uzupelnij"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "typ": {
                "const": "wybierz_wyraz"
              }
            }
          },
          "then": {
            "properties": {
              "dane": {
                "$ref": "#/$defs/d_wybierz"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "typ": {
                "const": "pisanie_sylab"
              }
            }
          },
          "then": {
            "properties": {
              "dane": {
                "$ref": "#/$defs/d_pisanie"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "typ": {
                "const": "czytanie_zdan"
              }
            }
          },
          "then": {
            "properties": {
              "dane": {
                "$ref": "#/$defs/d_zdania"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "typ": {
                "const": "dyktando_sylabowe"
              }
            }
          },
          "then": {
            "properties": {
              "dane": {
                "$ref": "#/$defs/d_dyktando"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "typ": {
                "const": "ramka_rysunkowa"
              }
            }
          },
          "then": {
            "properties": {
              "dane": {
                "$ref": "#/$defs/d_ramka"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "typ": {
                "const": "formularz"
              }
            }
          },
          "then": {
            "properties": {
              "dane": {
                "$ref": "#/$defs/d_formularz"
              }
            }
          }
        }
      ]
    },
    "d_tabela": {
      "type": "object",
      "required": [
        "wiersze"
      ],
      "additionalProperties": false,
      "properties": {
        "wiersze": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        },
        "naglowki_kolumn": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "naglowki_wierszy": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "d_sciezka": {
      "type": "object",
      "required": [
        "kroki"
      ],
      "additionalProperties": false,
      "properties": {
        "kroki": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string"
          }
        },
        "meta": {
          "type": "string"
        }
      }
    },
    "d_lacz": {
      "type": "object",
      "required": [
        "lewa",
        "prawa",
        "pary"
      ],
      "additionalProperties": false,
      "description": "pary: indeksy [lewa, prawa] tworzące wyraz. Renderer tasuje kolumnę prawą.",
      "properties": {
        "lewa": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string"
          }
        },
        "prawa": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string"
          }
        },
        "pary": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "d_wyrazy": {
      "type": "object",
      "required": [
        "wyrazy"
      ],
      "additionalProperties": false,
      "properties": {
        "wyrazy": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "wyraz",
              "sylaby"
            ],
            "additionalProperties": false,
            "properties": {
              "wyraz": {
                "type": "string"
              },
              "sylaby": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "d_uzupelnij": {
      "type": "object",
      "required": [
        "pozycje"
      ],
      "additionalProperties": false,
      "properties": {
        "pozycje": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "wzor",
              "opcje",
              "poprawna"
            ],
            "additionalProperties": false,
            "properties": {
              "wzor": {
                "type": "string"
              },
              "opcje": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "string"
                }
              },
              "poprawna": {
                "type": "integer",
                "minimum": 0
              },
              "ilustracja": {
                "$ref": "#/$defs/ilustracja"
              }
            }
          }
        }
      }
    },
    "d_wybierz": {
      "type": "object",
      "required": [
        "pozycje"
      ],
      "additionalProperties": false,
      "description": "Bez obrazków — podpowiedź czyta rodzic. Nie mamy API do generowania grafik.",
      "properties": {
        "pozycje": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "opcje",
              "poprawna"
            ],
            "additionalProperties": false,
            "properties": {
              "podpowiedz_rodzica": {
                "type": "string"
              },
              "opcje": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "string"
                }
              },
              "poprawna": {
                "type": "integer",
                "minimum": 0
              },
              "ilustracja": {
                "$ref": "#/$defs/ilustracja"
              }
            },
            "description": "Albo `ilustracja` (dziecko patrzy i wybiera samo), albo `podpowiedz_rodzica` (zdanie czytane przez dorosłego). Musi być jedno z dwóch.",
            "anyOf": [
              {
                "required": [
                  "ilustracja"
                ]
              },
              {
                "required": [
                  "podpowiedz_rodzica"
                ]
              }
            ]
          }
        }
      }
    },
    "d_pisanie": {
      "type": "object",
      "required": [
        "wzory"
      ],
      "additionalProperties": false,
      "properties": {
        "wzory": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "linie_na_wzor": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "liniatura": {
          "enum": [
            "trzylinia",
            "czterolinia",
            "gladka"
          ]
        }
      }
    },
    "d_zdania": {
      "type": "object",
      "required": [
        "zdania"
      ],
      "additionalProperties": false,
      "properties": {
        "zdania": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "pytanie": {
          "type": "string"
        }
      }
    },
    "d_dyktando": {
      "type": "object",
      "required": [
        "do_dyktowania"
      ],
      "additionalProperties": false,
      "description": "Rodzic dyktuje, dziecko zapisuje. Lista jest kluczem odpowiedzi.",
      "properties": {
        "do_dyktowania": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string"
          }
        },
        "liniatura": {
          "enum": [
            "trzylinia",
            "czterolinia",
            "gladka"
          ]
        }
      }
    },
    "d_ramka": {
      "type": "object",
      "required": [
        "wyrazy"
      ],
      "additionalProperties": false,
      "description": "Dziecko czyta wyraz i samo rysuje. Zastępuje ilustrację, której nie generujemy.",
      "properties": {
        "wyrazy": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "string"
          }
        },
        "wysokosc_ramki_mm": {
          "type": "integer",
          "minimum": 20
        }
      }
    },
    "d_formularz": {
      "type": "object",
      "required": [
        "pola"
      ],
      "additionalProperties": false,
      "description": "Rubryki do wypełnienia ręką. Typ współdzielony z ZESZYT-em i PORADNIK-iem. Zawsze puste.",
      "properties": {
        "pola": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "etykieta"
            ],
            "additionalProperties": false,
            "properties": {
              "etykieta": {
                "type": "string"
              },
              "wysokosc_mm": {
                "type": "integer",
                "minimum": 6
              },
              "linie": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "ilustracja": {
      "type": "object",
      "required": [
        "id",
        "brief"
      ],
      "additionalProperties": false,
      "description": "Zlecenie na ilustrację. `brief` opisuje TYLKO kadr — styl dokłada renderer/ilustracje.py, żeby cały zestaw wyglądał jak jedna talia. `id` jest per motyw, nie per pozycja: ten sam wyraz w dwóch tygodniach dzieli jeden obrazek.",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "brief": {
          "type": "string",
          "minLength": 10
        },
        "proporcje": {
          "enum": [
            "1:1",
            "3:2",
            "2:3",
            "16:9"
          ]
        }
      }
    }
  }
}
